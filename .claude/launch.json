{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swarm-gpu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5209
    },
    {
      "name": "swarm-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5213",
        "--strictPort",
        "--host"
      ],
      "port": 5213
    },
    {
      "name": "swarm-lan-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build && npx vite preview --port 5214 --strictPort --host"
      ],
      "port": 5214
    }
  ]
}
